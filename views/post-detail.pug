extends layout

block content
  .detail-container
    //- Panel principal (Imagen y descripción)
    .detail-main-card
      .detail-image-wrapper
        img.detail-image(src=post.imagen alt=post.titulo)
        span.license-tag(class=post.licencia style="top: 1.5rem; right: 1.5rem; font-size: 0.9rem;")
          if post.licencia === 'copyright'
            i.fa-solid.fa-copyright
            |  Copyright Protegido
          else
            i.fa-solid.fa-lock-open
            |  Dominio Público

      .detail-info
        .detail-header
          div
            h1.detail-title= post.titulo
            .detail-meta
              .detail-meta-item Por 
                a(href=`/profile/${post.id_autor}` style="font-weight: 600; color: #818CF8;") @#{post.User ? post.User.username : 'anónimo'}
              .detail-meta-item Fecha: 
                strong #{new Date(post.fecha_creacion).toLocaleDateString('es-ES')}
              .detail-meta-item Valoración: 
                strong #{post.promedioValoracion} ★ (#{post.cantidadValoraciones} votos)
          
          //- Acciones rápidas (Favoritos y Editar/Borrar si es autor)
          if usuario
            .detail-actions(style="display: flex; gap: 0.75rem;")
              //- Botón Favorito
              form(action=`/api/collections/toggle-favorite/${post.id}` method="POST")
                button.btn-secondary(type="submit" title=esFavorito ? 'Quitar de favoritos' : 'Guardar en favoritos' style=esFavorito ? 'color: #EF4444; border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.05);' : '')
                  i(class=esFavorito ? 'fa-solid fa-heart' : 'fa-regular fa-heart')
              
              if post.id_autor === usuario.id
                a.btn-secondary(href=`#` onclick=`editarPost(${post.id})` title="Editar publicación")
                  i.fa-solid.fa-pen-to-square
                a.btn-secondary(href=`#` onclick=`eliminarPost(${post.id})` style="color: var(--danger);" title="Eliminar publicación")
                  i.fa-solid.fa-trash-can

        if post.descripcion
          p.detail-description= post.descripcion

        if post.Tags && post.Tags.length > 0
          .post-tags-list(style="margin-top: 0.5rem;")
            each t in post.Tags
              a.post-tag-item(href=`/posts?tag=${t.nombre}` style="font-size: 0.85rem; padding: 0.25rem 0.6rem;") ##{t.nombre}

        if post.licencia === 'copyright' && post.marca_agua_texto
          div(style="background: rgba(245, 158, 11, 0.05); border: 1px dashed rgba(245, 158, 11, 0.3); padding: 1rem; border-radius: var(--radius-sm); font-size: 0.85rem; display: flex; align-items: center; gap: 0.75rem; color: #F59E0B;")
            i.fa-solid.fa-circle-info(style="font-size: 1.2rem;")
            p Imagen protegida con marca de agua personalizada: 
              strong "#{post.marca_agua_texto}"
              | . No se permite su reproducción sin autorización del autor.

    //- Panel lateral (Valoración, Compra, Comentarios y Denuncias)
    .detail-side-panel
      if usuario
        //- Bloque de Valoración (Sólo si NO es el autor)
        if post.id_autor !== usuario.id
          .rating-section
            h3(style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.25rem;") Califica esta fotografía
            p(style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.5rem;") ¿Qué te parece el trabajo de @#{post.User.username}?
            form(action="/api/valoraciones" method="POST")
              input(type="hidden" name="id_publicacion" value=post.id)
              .rating-stars
                each star in [1, 2, 3, 4, 5]
                  button.rating-star-btn(type="submit" name="calificacion" value=star class=(miValoracion >= star ? 'selected' : ''))
                    i.fa-solid.fa-star
            if miValoracion > 0
              p(style="font-size: 0.75rem; color: var(--success); font-weight: 500; margin-top: 0.25rem;") Tu calificación actual: #{miValoracion} ★

        //- Bloque de Compra / "Me interesa" (Sólo si NO es el autor)
        if post.id_autor !== usuario.id
          div(style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; text-align: center; box-shadow: var(--shadow-sm);")
            h3(style="font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem;") ¿Te interesa adquirir esta foto?
            p(style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;") Notifica al autor y abre una conversación privada de negociación de forma automática.
            form(action=`/api/messages/interest/${post.id}` method="POST")
              button.btn-primary(type="submit" style="width: 100%;")
                i.fa-solid.fa-handshake
                |  ¡Me Interesa!

      //- Módulo de comentarios
      .comments-panel
        h3.comments-title 
          span
            i.fa-solid.fa-comments
            |  Comentarios (#{post.Comments ? post.Comments.length : 0})
          
          //- Botón para cerrar comentarios (Solo autor)
          if usuario && post.id_autor === usuario.id && post.comentarios_abiertos
            form(action=`/api/comments/close/${post.id}` method="POST" style="margin: 0;")
              button.btn-danger(type="submit" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;")
                i.fa-solid.fa-lock
                |  Cerrar comentarios

        .comments-list
          if post.Comments && post.Comments.length > 0
            each c in post.Comments
              .comment-card
                .comment-header
                  a.comment-author(href=`/profile/${c.id_usuario}`) @#{c.User ? c.User.username : 'anónimo'}
                  span.comment-date #{new Date(c.fecha_creacion).toLocaleDateString('es-ES')}
                p.comment-content= c.contenido
                
                if usuario
                  .comment-actions
                    //- Denunciar comentario (Si no es tuyo)
                    if c.id_usuario !== usuario.id
                      a.action-link(href="#" onclick=`toggleDenunciarComentario(${c.id})` title="Denunciar comentario")
                        i.fa-solid.fa-flag
                        |  Denunciar
                    
                    //- Borrar comentario (Si eres el creador del comentario o el dueño de la foto)
                    if c.id_usuario === usuario.id || post.id_autor === usuario.id
                      a.action-link.danger-action(href="#" onclick=`eliminarComentario(${c.id})` title="Eliminar comentario")
                        i.fa-solid.fa-trash-can
                        |  Borrar

                  //- Mini formulario de denuncia de comentario (Oculto inicialmente)
                  div(id=`form-denuncia-comentario-${c.id}` style="display: none; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--border-color);")
                    form(action=`/api/comments/${c.id}/denunciar` method="POST" onsubmit="enviarDenunciaComentario(event, this)")
                      .form-group(style="margin-bottom: 0.5rem;")
                        select.filter-select(name="motivo" required style="width: 100%; font-size: 0.8rem; padding: 0.4rem;")
                          option(value="" disabled selected) Seleccionar motivo...
                          option(value="Lenguaje inapropiado") Lenguaje ofensivo/inapropiado
                          option(value="Spam") Mensaje basura / Spam
                          option(value="Acoso") Acoso o incitación al odio
                          option(value="Otros") Otros
                      .form-group(style="margin-bottom: 0.5rem;")
                        textarea.comment-textarea(name="descripcion" placeholder="Explica brevemente por qué denuncias el comentario..." required style="height: 50px; font-size: 0.8rem;")
                      button.btn-danger(type="submit" style="font-size: 0.75rem; width: 100%;") Enviar Denuncia
          else
            p(style="text-align: center; color: var(--text-muted); font-size: 0.9rem; padding: 1.5rem 0;") No hay comentarios todavía.

        //- Formulario para comentar
        if post.comentarios_abiertos
          if usuario
            form.comment-form(action="/api/comments" method="POST")
              input(type="hidden" name="id_post" value=post.id)
              textarea.comment-textarea(name="contenido" placeholder="Escribe un comentario..." required)
              button.btn-primary(type="submit" style="align-self: flex-end; padding: 0.5rem 1.25rem; font-size: 0.9rem;") Comentar
          else
            p(style="text-align: center; font-size: 0.85rem; color: var(--text-secondary); background: rgba(255, 255, 255, 0.02); padding: 1rem; border-radius: var(--radius-sm); border: 1px dashed var(--border-color);")
              | Debes 
              a(href="/login" style="color: var(--accent-primary); font-weight: 600;") iniciar sesión
              |  para comentar.
        else
          div(style="text-align: center; font-size: 0.85rem; color: var(--danger); background: rgba(239, 68, 68, 0.03); border: 1px solid rgba(239, 68, 68, 0.15); padding: 0.75rem; border-radius: var(--radius-sm); font-weight: 500;")
            i.fa-solid.fa-lock
            |  Los comentarios están cerrados para esta foto.

      //- Bloque de Denunciar Publicación (Sólo para logueados y no autores del post)
      if usuario && post.id_autor !== usuario.id
        div(style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);")
          h3(style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; color: #F87171; display: flex; align-items: center; gap: 0.5rem;")
            i.fa-solid.fa-triangle-exclamation
            |  Reportar Imagen
          p(style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 1rem;") Si esta publicación infringe las normas de la comunidad, denúnciala aquí.
          form(action="/api/denuncias" method="POST" onsubmit="enviarDenunciaPost(event, this)")
            input(type="hidden" name="id_publicacion" value=post.id)
            .form-group
              label.form-label(for="motivo" style="font-size: 0.8rem;") Motivo de Reporte
              select#motivo.filter-select(name="motivo" required style="width: 100%;")
                option(value="" disabled selected) Seleccionar motivo...
                option(value="Derechos de Autor") Infracción de Derechos de Autor / Plagio
                option(value="Contenido Inapropiado") Contenido inapropiado / Sensible
                option(value="Spam o Engaño") Spam, estafa o engaño
                option(value="Otros") Otros motivos
            .form-group
              label.form-label(for="descripcion" style="font-size: 0.8rem;") Descripción / Justificación
              textarea#descripcion.comment-textarea(name="descripcion" placeholder="Proporciona una justificación detallada..." required style="height: 70px;")
            button.btn-danger(type="submit" style="width: 100%;")
              i.fa-solid.fa-bullhorn
              |  Enviar Reporte

  script.
    // Editar publicación
    function editarPost(id) {
      const nuevoTitulo = prompt("Ingresa el nuevo título para la publicación:");
      if (nuevoTitulo === null) return;
      const nuevaDesc = prompt("Ingresa la nueva descripción:");
      if (nuevaDesc === null) return;

      fetch('/api/posts/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ titulo: nuevoTitulo, description: nuevaDesc })
      })
      .then(res => res.json())
      .then(data => {
        if (data.error) {
          alert(data.message || data.error);
        } else {
          alert("Publicación actualizada con éxito");
          window.location.reload();
        }
      });
    }

    // Eliminar publicación
    function eliminarPost(id) {
      if (confirm("¿Estás completamente seguro de que deseas eliminar esta publicación? Esta acción borrará todas sus valoraciones, comentarios y reportes asociados.")) {
        fetch('/api/posts/' + id, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
          if (data.error) {
            alert(data.error);
          } else {
            alert("Publicación eliminada correctamente");
            window.location.href = '/posts';
          }
        });
      }
    }

    // Eliminar comentario
    function eliminarComentario(id) {
      if (confirm("¿Seguro que deseas eliminar este comentario?")) {
        fetch('/api/comments/' + id, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
          if (data.error) alert(data.error);
          else window.location.reload();
        });
      }
    }

    // Mostrar/Ocultar formulario de denuncia de comentario
    function toggleDenunciarComentario(id) {
      const form = document.getElementById('form-denuncia-comentario-' + id);
      form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }

    // Enviar denuncia de comentario por AJAX
    function enviarDenunciaComentario(e, form) {
      e.preventDefault();
      const action = form.action;
      const data = {
        motivo: form.querySelector('[name="motivo"]').value,
        descripcion: form.querySelector('[name="descripcion"]').value
      };

      fetch(action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(data => {
        if (data.error) alert(data.error);
        else {
          alert(data.message);
          form.reset();
          form.parentElement.style.display = 'none';
        }
      });
    }

    // Enviar denuncia de publicación por AJAX
    function enviarDenunciaPost(e, form) {
      e.preventDefault();
      const action = form.action;
      const data = {
        id_publicacion: form.querySelector('[name="id_publicacion"]').value,
        motivo: form.querySelector('[name="motivo"]').value,
        descripcion: form.querySelector('[name="descripcion"]').value
      };

      fetch(action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(res => res.json())
      .then(data => {
        if (data.error) alert(data.error);
        else {
          alert(data.message);
          window.location.reload(); // Recarga para aplicar bloqueos de edición si corresponde
        }
      });
    }
