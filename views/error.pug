extends layout

block content
  div(style="text-align: center; max-width: 600px; margin: 4rem auto; background: var(--bg-card); border: 1px solid var(--border-color); padding: 3rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);")
    i.fa-solid.fa-circle-exclamation(style="font-size: 4rem; color: var(--danger); margin-bottom: 1.5rem; display: block;")
    h1(style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem;") Ha ocurrido un inconveniente
    p(style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 2rem;")= message || 'La accion solicitada no pudo ser procesada debido a restricciones del sistema o permisos denegados.'
    a.btn-primary(href="/posts")
      i.fa-solid.fa-house
      |  Volver al Inicio
