doctype html
html
  head
    title Lista de Usuarios
  body
    h1 Usuarios Registrados en Fotaza 2
    
    //- Si hay usuarios, mostramos la tabla
    if users && users.length > 0
      table(border='1')
        thead
          tr
            th ID
            th Username
            th Email
        tbody
          //- Iteramos sobre cada objeto usuario recibido
          each user in users
            tr
              td= user.id
              td= user.username
              td= user.email
    else
      
      p No hay usuarios registrados aún.